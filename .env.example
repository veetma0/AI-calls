# Mock makes no network calls. Switch only after following docs/voximplant.md.
MODE=mock
# Generate unique values with: python scripts/init_env.py
ADMIN_TOKEN=
INTERNAL_SECRET=
DATABASE_PATH=data/calls.sqlite3
PRODUCT_CONFIG_PATH=config/product.json

DOMAIN=
PUBLIC_BASE_URL=
VOXIMPLANT_ACCOUNT_ID=
VOXIMPLANT_API_KEY=
VOXIMPLANT_RULE_ID=
CALLER_ID=
ELEVENLABS_AGENT_ID=
# ElevenLabs API key lives in Voximplant Secrets, never in the browser.

MAX_CONCURRENT=1
DAILY_ATTEMPT_LIMIT=20
MAX_DURATION_SEC=180
RINGING_TIMEOUT_SEC=30
CALL_WINDOW_START=9
CALL_WINDOW_END=20
DEFAULT_TIMEZONE=Europe/Moscow
# Pilot: your own consenting phone(s), normalized +7..., separated by comma.
LIVE_ALLOWED_NUMBERS=
ALLOW_ALL_CONSENTED_NUMBERS=false
WORKER_INTERVAL_SEC=1
